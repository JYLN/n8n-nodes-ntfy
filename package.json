{
	"name": "@jyln/n8n-nodes-ntfy",
	"version": "2.0.0",
	"description": "A community n8n node for ntfy.sh",
	"license": "MIT",
	"homepage": "https://github.com/JYLN/n8n-nodes-ntfy.git",
	"keywords": [
		"n8n-community-node-package",
		"ntfy",
		"ntfy.sh",
		"notification",
		"communication",
		"n8n"
	],
	"author": {
		"name": "JYLN",
		"email": "contact@jyln.dev"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JYLN/n8n-nodes-ntfy.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/NtfyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Ntfy/Ntfy.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^25.0.10",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
